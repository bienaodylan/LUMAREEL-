{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/payments/jekopay/initiate",
      "destination": "/api/payments?route=initiate"
    },
    {
      "source": "/api/payments/jekopay/confirm-preview",
      "destination": "/api/payments?route=confirm-preview"
    },
    {
      "source": "/api/payments/jekopay/config",
      "destination": "/api/payments?route=config"
    },
    {
      "source": "/api/payments/jekopay/webhook",
      "destination": "/api/payments?route=webhook"
    },
    {
      "source": "/api/payments/jekopay/verify/:reference",
      "destination": "/api/payments?route=verify&reference=:reference"
    },
    {
      "source": "/api/payments/readiness",
      "destination": "/api/payments?route=readiness"
    },
    {
      "source": "/api/email/test",
      "destination": "/api/payments?route=email-test"
    },
    {
      "source": "/api/membership/editions",
      "destination": "/api/payments?route=editions"
    },
    {
      "source": "/api/membership/my-card",
      "destination": "/api/payments?route=my-card"
    },
    {
      "source": "/api/membership/order",
      "destination": "/api/payments?route=order"
    },
    {
      "source": "/api/wallet/overview",
      "destination": "/api/payments?route=wallet-overview"
    },
    {
      "source": "/api/orders",
      "destination": "/api/payments?route=orders"
    },
    {
      "source": "/api/customer/orders",
      "destination": "/api/payments?route=customer-orders"
    },
    {
      "source": "/api/tickets/transfer",
      "destination": "/api/payments?route=transfer-ticket"
    },
    {
      "source": "/((?!api/|assets/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm install"
}
