{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run lint && npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "bun install --frozen-lockfile"
}
