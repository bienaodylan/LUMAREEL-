# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# --- SÉCURITÉ & SESSIONS (OBLIGATOIRE, >= 32 CARACTÈRES ALÉATOIRES) ---
SESSION_SECRET="change-me-to-a-64-char-random-hex-string-in-production-only"

# --- BOOTSTRAP ADMIN INITIAL (OPTIONNEL, CRÉÉ UNIQUEMENT S'IL N'EXISTE AUCUN SUPER_ADMIN) ---
# ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="minimum-12-characters-strong-password"

# --- MODE DE PAIEMENT ('live' EN PRODUCTION, 'sandbox' UNIQUEMENT EN DEV) ---
PAYMENT_MODE="sandbox"
MEMBERSHIP_WELCOME_CREDIT_XOF="5000"

# --- ORIGINE CORS AUTORISÉE (LISTE SÉPARÉE PAR DES VIRGULES EN PRODUCTION) ---
ALLOWED_ORIGINS="http://localhost:3000"

# --- CONFIGURATION SUPABASE (OPTIONNELLE, LECTURE SEULE VIA ENV) ---
# VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- MOYEN DE PAIEMENT (CÔTÉ SERVEUR UNIQUEMENT) ---
GENIUSPAY_PUBLIC_KEY="pk_sandbox_..."
GENIUSPAY_SECRET_KEY="sk_sandbox_..."
GENIUSPAY_WEBHOOK_SECRET="whsec_change_me_in_production"
GENIUSPAY_API_URL="https://api.geniuspay.example"
